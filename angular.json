{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Invoice": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/invoice",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",

              {

                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/assets/fonts/remix/remixicon.css",
              "src/assets/css/main.min.css",
              "src/assets/vendor/overlay-scroll/OverlayScrollbars.min.css",
              "node_modules/remixicon/fonts/remixicon.css"


            ],
            "scripts": [
              "src/assets/js/moment.min.js",
              "src/assets/js/appointments-calendar.js",
              "src/assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js",
              "src/assets/vendor/overlay-scroll/custom-scrollbar.js",
              "src/assets/js/custom.js",
              "src/assets/vendor/calendar/js/main.min.js",
              "src/assets/vendor/calendar/custom/daygrid-calendar.js",
              "src/assets/vendor/apex/apexcharts.min.js",
              "src/assets/vendor/apex/custom/home/patients.js",
              "src/assets/vendor/apex/custom/home/treatment.js",
              "src/assets/vendor/apex/custom/home/available-beds.js",   
              "src/assets/vendor/apex/custom/home/earnings.js",
              "src/assets/vendor/apex/custom/home/gender-age.js",
              "src/assets/vendor/apex/custom/home/claims.js",
              "src/assets/vendor/apex/custom/dashboard2/activity.js",
              "src/assets/vendor/apex/custom/dashboard2/income.js",
              "src/assets/vendor/apex/custom/dashboard2/orders.js",
              "src/assets/vendor/rating/raty.js",
              "src/assets/vendor/rating/raty-custom.js",
              "src/assets/vendor/apex/custom/dentist/patients.js", 
              "src/assets/vendor/apex/custom/dentist/appointments.js",
              "src/assets/vendor/apex/custom/dentist/surgeries.js",
              "src/assets/vendor/apex/custom/dentist/income.js",
              "src/assets/vendor/apex/custom/dentist/earnings.js",
              "src/assets/vendor/apex/custom/dentist/gender-age.js",
              "src/assets/vendor/apex/custom/dentist/claims.js",
              "src/assets/vendor/gallery/baguetteBox.js",
              "src/assets/vendor/gallery/plugins.js",
              "src/assets/vendor/gallery/custom-gallery.js",
              "src/assets/vendor/jvectormap/jquery-jvectormap-2.0.5.min.js",
              "src/assets/vendor/jvectormap/africa-mill.js",
              "src/assets/vendor/jvectormap/dk-mill.js",
              "src/assets/vendor/jvectormap/europe-mill.js",
              "src/assets/vendor/jvectormap/world-mill-en.js",
              "src/assets/vendor/jvectormap/gdp-data.js",
              "src/assets/vendor/jvectormap/us_aea.js",
              "src/assets/vendor/jvectormap/usa.js",
              "src/assets/vendor/jvectormap/continents-mill.js",
              "src/assets/vendor/jvectormap/custom/world-map-markers2.js",
              "src/assets/vendor/jvectormap/custom/world-map-gdp.js",
              "src/assets/vendor/jvectormap/custom/map-usa.js",
              "src/assets/vendor/jvectormap/custom/map-usa2.js",
              "src/assets/vendor/jvectormap/custom/custom-denmark.js",
              "src/assets/vendor/jvectormap/custom/map-europe.js",
              "src/assets/vendor/jvectormap/custom/map-africa.js",
              "src/assets/vendor/apex/custom/doc-dashboard/patients.js",
              "src/assets/vendor/apex/custom/doc-dashboard/appointments.js",
              "src/assets/vendor/apex/custom/doc-dashboard/gender.js",
              "src/assets/vendor/apex/custom/doc-dashboard/surgeries.js",
              "src/assets/vendor/apex/custom/doc-dashboard/income.js",
              "src/assets/vendor/datatables/dataTables.min.js",
              "src/assets/vendor/datatables/dataTables.bootstrap.min.js",
              "src/assets/vendor/datatables/custom/custom-datatables.js",
              "src/assets/vendor/dropzone/dropzone.min.js",
              "src/assets/vendor/quill/quill.min.js", 
              "src/assets/vendor/quill/custom.js",
              "src/assets/vendor/apex/apexcharts.min.js",
              "src/assets/vendor/apex/custom/patients/sparklines.js",
              "src/assets/vendor/apex/custom/patients/insuranceClaims.js",
              "src/assets/vendor/apex/custom/patients/medicalExpenses.js",
              "src/assets/vendor/apex/custom/patients/healthActivity.js",
              "src/assets/vendor/calendar/custom/appointments-calendar.js",
              "src/assets/vendor/apex/custom/department/department-list.js",
              "src/assets/vendor/apex/custom/department/employees.js",
              "src/assets/vendor/apex/custom/income/income.js",
              "src/assets/js/table-random-colors.js",
              "src/assets/vendor/apex/custom/payments/payments.js",
              "src/assets/vendor/datatables/buttons/dataTables.buttons.min.js",
              "src/assets/vendor/datatables/buttons/jszip.min.js",
              "src/assets/vendor/datatables/buttons/pdfmake.min.js",
              "src/assets/vendor/datatables/buttons/vfs_fonts.js",
              "src/assets/vendor/datatables/buttons/buttons.html5.min.js",
              "src/assets/vendor/datatables/buttons/buttons.print.min.js",
              "src/assets/vendor/datatables/buttons/buttons.colVis.min.js",
              "src/assets/vendor/daterange/daterange.js",
              "src/assets/vendor/daterange/custom-daterange.js",
              "src/assets/vendor/apex/custom/expenses/expenses.js",
              "src/assets/vendor/calendar/custom/google-view-calendar.js",
              "src/assets/vendor/month/month.js",
              "src/assets/vendor/apex/custom/rooms/admissions.js",
              "src/assets/js/validations.js",
              "src/assets/vendor/input-tags/tagsinput.min.js",
              "src/assets/vendor/input-tags/typeahead.js",
              "src/assets/vendor/input-tags/tagsinput-custom.js",
              "src/assets/vendor/input-masks/cleave.min.js",
              "src/assets/vendor/input-masks/cleave-phone.js",
              "src/assets/vendor/input-masks/cleave-custom.js",
              "src/assets/vendor/apex/custom/graphs/area.js",
              "src/assets/vendor/apex/custom/graphs/line.js",
              "src/assets/vendor/apex/custom/graphs/bar.js",
              "src/assets/vendor/apex/custom/graphs/column-area.js",
              "src/assets/vendor/apex/custom/graphs/candlestick.js",
              "src/assets/vendor/apex/custom/graphs/heatmap.js",
              "src/assets/vendor/apex/custom/graphs/donut.js",
              "src/assets/vendor/apex/custom/graphs/pie.js",
              "src/assets/vendor/apex/custom/graphs/gauge.js",
              "src/assets/vendor/apex/custom/graphs/radial-bar.js",
              "src/assets/vendor/apex/custom/graphs/funnel.js",
              "src/assets/vendor/apex/custom/graphs/pyramid.js",
              "src/assets/vendor/morris/raphael-min.js",
              "src/assets/vendor/morris/morris.min.js",
              "src/assets/vendor/morris/custom/area.js",
              "src/assets/vendor/morris/custom/barColors.js",
              "src/assets/vendor/morris/custom/dayData.js",
              "src/assets/vendor/morris/custom/donutColors.js",
              "src/assets/vendor/morris/custom/donutFormatter.js",
              "src/assets/vendor/morris/custom/morrisBar.js",
              "src/assets/vendor/morris/custom/negativeValues.js",
              "src/assets/vendor/morris/custom/stackedBar.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Invoice:build:production"
            },
            "development": {
              "buildTarget": "Invoice:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
